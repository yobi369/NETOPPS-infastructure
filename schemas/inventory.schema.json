{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yobi369/NETOPPS-infastructure/blob/main/schemas/inventory.schema.json",
  "title": "NETOPPS Inventory",
  "description": "Version 1 inventory interchange format. Semantic network overlap checks are performed by the NETOPPS validator, not by this JSON Schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "devices", "networks"],
  "properties": {
    "schema_version": { "const": 1 },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "hostname", "management_ip", "role"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "hostname": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          "management_ip": { "type": "string", "format": "ip-address" },
          "management_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
          "role": { "enum": ["router", "switch", "firewall", "server", "access_point", "load_balancer", "other"] },
          "site": { "type": "string", "minLength": 1 }
        }
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "cidr"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "cidr": { "type": "string", "minLength": 3 },
          "site": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
